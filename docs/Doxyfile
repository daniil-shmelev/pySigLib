PROJECT_NAME = siglib
OUTPUT_DIRECTORY = _build/doxygen
INPUT = ../siglib/cpsig/cpsig.h ../siglib/cusig/cusig.h
FILE_PATTERNS = *.h
QUIET = YES
WARN_IF_UNDOCUMENTED = YES
WARN_IF_DOC_ERROR = YES
