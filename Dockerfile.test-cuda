# Pre-built test image for pysiglib CUDA wheels. Based on nvidia/cuda's
# runtime image (libcudart + driver glue only, no toolkit/nvcc) with Python,
# pytest, pytest-timeout and torch pre-installed. Each test-linux-cuda run in
# wheels.yml only has to `pip install <wheel>` — no apt-get, no ~2 GB torch
# redownload per run.
#
# Build locally:
#   docker build -t pysiglib-test-cuda12:local -f Dockerfile.test-cuda .
#
# Push via .github/workflows/build-test-image.yml, which tags the image as
# ghcr.io/<owner>/pysiglib-test-cuda12:cuda-<version>.

ARG CUDA_VERSION=12.9.1
FROM nvidia/cuda:${CUDA_VERSION}-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update -qq && \
    apt-get install -y -qq --no-install-recommends \
        python3 \
        python3-pip \
        git \
        ca-certificates && \
    rm -rf /var/lib/apt/lists/*

# Pin nothing here — torch tracks whatever CUDA runtime the base image ships.
# Rebuild the image whenever you need to bump the torch version.
# Ubuntu 22.04's system Python is not externally-managed (pre-PEP-668), so
# system-wide pip installs work without --break-system-packages.
RUN python3 -m pip install --no-cache-dir \
        numpy \
        pytest \
        pytest-timeout \
        torch

WORKDIR /tmp
